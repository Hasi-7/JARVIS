# Brain UI backend — environment variables (reference)
#
# Copy to backend/.env and set values, OR export these in the shell before
# launching uvicorn. The backend reads process environment variables directly
# (no auto-loading of .env in this build). Vault path and brain.cmd path can
# alternatively be set from the Settings page (persisted to
# backend/data/brain-ui-config.json).
#
# backend/.env is gitignored. Never commit real secrets or tokens.

# ── Core paths (also settable via Settings UI) ────────────────────────────────
# Highest priority: env > backend/data/brain-ui-config.json > built-in defaults.
BRAIN_UI_VAULT_PATH=D:\Hasnain\Personal\OneDrive - University of Toronto\AI-Command-Center
BRAIN_UI_BRAIN_CMD=D:\Hasnain\Personal\bin\brain.cmd

# ── Local LLM (Ollama) — used by the Local Agent + AI-assist features ──────────
BRAIN_UI_OLLAMA_BASE_URL=http://localhost:11434
# Pull a model first:  ollama pull <model>
# Fixed API tiers map to these configured models; clients cannot submit model names.
# Pull first: ollama pull gemma4:12b-it-qat
#             ollama pull gemma4:26b-a4b-it-qat
BRAIN_UI_LOCAL_MODEL=gemma4:12b-it-qat
BRAIN_UI_LOCAL_MODEL_HEAVY=gemma4:26b-a4b-it-qat
# Max prior user/assistant messages sent as context (default 10).
BRAIN_UI_CONTEXT_WINDOW_MESSAGES=10

# ── Gated local agent execution (A3) ──────────────────────────────────────────
# Default false. Assist-mode approval requests may queue while false, but cannot
# be approved or executed until the backend process is started with this set true.
# This gates the durable approval state machine: brain.today, brain.sync_raw,
# vault.create_task, calendar.create_candidate, calendar.create_event,
# browser.search, browser.read_page, vault.update_entity, and
# computer.start_session. It does not enable generic filesystem writes or shell,
# and computer-use additionally needs BRAIN_UI_COMPUTER_USE_ENABLED.
BRAIN_UI_PRIVILEGED_EXECUTION_ENABLED=false
# Mandatory and separate from the kill switch. Set a strong random value in the
# backend process environment and send it only as X-Brain-Approval-Token on
# approve/reject/execute requests. Never commit the real value.
BRAIN_UI_APPROVAL_TOKEN=
# Run the approval backend with one Uvicorn worker. Locking is process-local, and
# a crash after a possible side effect intentionally remains executing/no-retry.

# ── Privileged runtimes ───────────────────────────────────────────────────────
# Setting any of these enables NOTHING on its own. Every privileged capability
# additionally requires the approval queue, Assist mode, the operator token, and
# BRAIN_UI_PRIVILEGED_EXECUTION_ENABLED; computer-use needs its own kill switch
# on top of that. These only tell the backend where a runtime lives.
# OPENCLAW_ENABLED=false
# OPENCLAW_BASE_URL=
# NVIDIA OpenShell gateway (C0). Verified working 2026-08-23 against OpenShell
# 0.0.111 running in WSL2. The gateway is gRPC over HTTP/2 with mutual TLS —
# there is no REST API, so these are consumed by app/openshell_client.py.
# NEMOCLAW_ENABLED=false
#
# Gateway endpoint. Must include the port (default 17670). WSL2 forwards
# localhost, so the Windows backend reaches a WSL2 gateway at localhost — this
# stays loopback and does NOT require NEMOCLAW_ALLOW_REMOTE_PROBE.
# NEMOCLAW_RUNTIME_URL=https://localhost:17670
#
# Directory holding the gateway's mTLS material (ca.crt, tls.crt, tls.key).
# For a WSL2 gateway this is reachable from Windows over the WSL UNC share:
#   \\wsl.localhost\<Distro>\home\<user>\.config\openshell\gateways\<gateway>\mtls
# Contents are read for the TLS handshake only — never logged, echoed, or returned.
# NEMOCLAW_MTLS_DIR=
#
# Overrides the TLS server name used for verification. Defaults to
# host.openshell.internal, which is in the gateway certificate's SAN list.
# NEMOCLAW_TLS_SERVER_NAME=host.openshell.internal
#
# Sandbox policy file (YAML) applied via: openshell policy set <name> --policy <file>
# Inspected read-only by app/runtime_policy.py. Requires PyYAML (now a dependency).
# NEMOCLAW_POLICY_PATH=
#
# Only needed for a NON-loopback gateway. Leave false for WSL2/local setups.
# NEMOCLAW_ALLOW_REMOTE_PROBE=false
# ENABLE_BROWSER_HARNESS=false
# ENABLE_COMPUTER_USE=false
# ENABLE_MCP_GATEWAY=false
#
# NOTE on PRD §31's other NEMOCLAW_* concepts (DEFAULT_MODE, ALLOW_BROWSER,
# ALLOW_COMPUTER_USE, ALLOWED_DOWNLOAD_DIRS, ALLOWED_VAULT_PATHS): deliberately
# NOT added as settings. Configuration for behaviour this app does not implement
# would imply the runtime honours it, which is the same kind of false claim the
# rest of this build has been removing. Network policy and filesystem scopes are
# read from the sandbox policy YAML instead, where OpenShell actually enforces
# them — see backend/policies/jarvis-deny-by-default.yaml.

# ── Local voice transcription (D1) ────────────────────────────────────────────
# faster-whisper runs entirely on this machine; microphone audio is NEVER sent to
# a cloud speech service. The only network access is a one-time model download.
# BRAIN_UI_WHISPER_MODEL=base.en
# BRAIN_UI_WHISPER_DEVICE=cpu          # AMD GPU here, so CUDA does not apply
# BRAIN_UI_WHISPER_COMPUTE_TYPE=int8
# BRAIN_UI_WHISPER_CACHE=              # model cache dir (default: HF cache)
# BRAIN_UI_WHISPER_LOCAL_ONLY=false    # true forbids even the model download

# ── Approved Google Calendar event creation (D2) ──────────────────────────────
# THE ONLY EXTERNAL WRITE THIS APP PERFORMS. Off by default.
# Setting this true only makes the local consent flow REQUEST the calendar.events
# scope — you must then re-run `python -m app.google_auth authorize` and approve it
# in the browser. Changing scopes invalidates the existing token, which is why
# authorize now falls back to consent instead of dead-ending on refresh failure.
#
# Even with the scope granted, creating an event still requires ALL of:
#   Assist mode -> BRAIN_UI_APPROVAL_TOKEN -> BRAIN_UI_PRIVILEGED_EXECUTION_ENABLED
#   -> explicit approve -> separate explicit execute
# Events are created with sendUpdates=none and no attendees, so creating one can
# never email anybody. Update/move/delete are not implemented and never will be.
# BRAIN_UI_CALENDAR_WRITE_ENABLED=false

# ── D3 read-only integrations ─────────────────────────────────────────────────
# GitHub: a token with READ-ONLY scopes (public_repo / repo:status, or a
# fine-grained token with read access). Only GET requests are ever issued; there
# is no write, merge, or comment path in the backend. Never commit the real value.
# BRAIN_UI_GITHUB_TOKEN=

# Google Drive intake: requests the drive.readonly scope. Like the Calendar write
# scope, setting this only changes what consent ASKS for — you must re-run
# `python -m app.google_auth authorize` and approve it. Read-only forever: there
# is no Drive create/update/delete/share code path.
# BRAIN_UI_DRIVE_INTAKE_ENABLED=false

# Local vault semantic search: embeddings come from your local Ollama instance,
# so no vault text leaves the machine. Without this model, search degrades to
# lexical scoring and reports `degraded: true` rather than pretending otherwise.
#   ollama pull nomic-embed-text
# BRAIN_UI_EMBED_MODEL=nomic-embed-text

# ── Vault tool-log mirror (PRD §32) ───────────────────────────────────────────
# Mirrors every gateway evaluation/execution into
# ops/tool-logs/YYYY-MM-DD-tool-log.md so the audit record stays readable from
# Obsidian alone. Append-only; the backend JSON remains the queryable source, and
# a mirror failure never fails the action being recorded. On by default.
# BRAIN_UI_VAULT_TOOL_LOG=true

# ── Canvas / Quercus intake (MVP v10) ─────────────────────────────────────────
# Read-only Canvas REST access. Create a token at:
#   https://q.utoronto.ca/profile/settings  →  + New Access Token
# Only GET requests are ever issued; there is no submit, upload, enroll, or grade
# path in the backend. Assignment SUBMISSION is deliberately out of scope.
# BRAIN_UI_QUERCUS_TOKEN=
# BRAIN_UI_QUERCUS_HOST=q.utoronto.ca

# ── Computer-use harness (MVP v7) — FULL DESKTOP CONTROL ──────────────────────
# OFF BY DEFAULT, and it should stay off unless you are actively using it.
# When enabled, this app can click and type on your REAL desktop. There is no
# sandbox boundary around host control, so the following guards are the safety:
#
#   * a session must be started with a scoped task AND an explicit window
#     allowlist — an empty allowlist is rejected;
#   * before every action the FOREGROUND WINDOW must match that allowlist; if
#     focus has moved, the action is REFUSED, never retargeted;
#   * PRD §13.4 risky categories (send/submit/delete/download/upload/settings/
#     purchase/credentials/permissions) need per-action confirmation, and typing
#     into a credential window is refused outright and cannot be confirmed;
#   * a wall-clock budget and an action cap end the session automatically;
#   * pyautogui's corner failsafe stays on — slam the pointer into a screen
#     corner to abort;
#   * every action, including every refusal, is logged.
#
# Mutating calls also require BRAIN_UI_APPROVAL_TOKEN. Stopping a session is
# deliberately NOT gated, so the emergency stop always works.
# BRAIN_UI_COMPUTER_USE_ENABLED=false
